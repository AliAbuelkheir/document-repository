{
  "name": "document-repository-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "prisma generate && tsc",
    "start": "node dist/src/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "node dist/prisma/studio.js"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "content-disposition": "3.0.0",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "file-type": "22.2.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jsonwebtoken": "9.0.3",
    "multer": "2.5.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prisma": "7.10.1",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.2",
    "@types/swagger-ui-express": "4.1.8",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
