# Copy this file to .env. Only docker-compose.yml reads it.

# ---- PostgreSQL ----
POSTGRES_USER=docrepo
POSTGRES_PASSWORD=docrepo
POSTGRES_DB=docrepo
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PORT=6379

# ---- Backend ----
BACKEND_PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
STUDIO_PORT=5555

# ---- Frontend ----
FRONTEND_PORT=3000

# The seed makes two accounts with the password Password123!:
# admin@docrepo.local and user@docrepo.local.
