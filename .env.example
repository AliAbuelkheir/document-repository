# Copy to .env and adjust. docker-compose.yml reads these values (with the defaults below).
# For local dev, backend/ and frontend/ read the same variables from the process environment.

# ---- PostgreSQL ----
# Database user created by the postgres container.
POSTGRES_USER=docrepo
# Password for POSTGRES_USER.
POSTGRES_PASSWORD=docrepo
# Database name created on first start.
POSTGRES_DB=docrepo
# Host port mapped to postgres:5432.
POSTGRES_PORT=5432

# ---- Redis ----
# Host port mapped to redis:6379.
REDIS_PORT=6379

# ---- Backend ----
# development | production | test
NODE_ENV=development
# Port the Express API listens on (also the host port in Docker).
BACKEND_PORT=4000
# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---- Frontend ----
# Host port mapped to the Next.js server.
FRONTEND_PORT=3000
# Where Next.js forwards /api/* requests. Docker sets http://backend:4000.
BACKEND_URL=http://localhost:4000
