# Copy this file to .env. Only docker-compose.yml reads it.

# ---- PostgreSQL ----
POSTGRES_USER=docrepo
POSTGRES_PASSWORD=docrepo
POSTGRES_DB=docrepo
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PORT=6379

# ---- Backend ----
BACKEND_PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
STUDIO_PORT=5555
# Signs the session tokens. Use a random value of at least 32 characters,
# for example the output of: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-value-of-at-least-32-characters

# ---- Frontend ----
FRONTEND_PORT=3000

# The seed makes two accounts with the password Password123!:
# admin@docrepo.local and user@docrepo.local.
